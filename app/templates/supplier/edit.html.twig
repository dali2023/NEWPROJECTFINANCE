{% extends 'base.html.twig' %}

{% block title %}Modifier {{ supplier.name }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_supplier_index') }}">Fournisseurs</a> / {{ supplier.code }} / Modifier{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Modifier le fournisseur</h1>
            <div class="page-head__subtitle">
                {{ supplier.code }} — {{ supplier.name }}
                {% if supplier.isActive %}
                    <span class="badge badge--success">Actif</span>
                {% else %}
                    <span class="badge badge--muted">Inactif</span>
                {% endif %}
            </div>
        </div>
        <div class="page-head__actions">
            <form class="inline-form" method="post" action="{{ path('app_supplier_toggle', {id: supplier.idString}) }}"
                  data-confirm="{{ supplier.isActive ? 'Désactiver ce fournisseur ?' : 'Réactiver ce fournisseur ?' }}">
                <input type="hidden" name="_token" value="{{ csrf_token('supplier_toggle_' ~ supplier.idString) }}">
                <button class="btn {{ supplier.isActive ? 'btn--danger' : '' }}" type="submit">
                    {{ supplier.isActive ? 'Désactiver' : 'Réactiver' }}
                </button>
            </form>
        </div>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <section class="card">
            <div class="card__header"><div class="card__title">Identification</div></div>
            <div class="card__body">
                <div class="form-grid">
                    {{ form_row(form.code) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.taxIdentifier) }}
                    {{ form_row(form.serviceCategory) }}
                </div>
            </div>
        </section>

        <section class="card" style="margin-top:1rem;">
            <div class="card__header"><div class="card__title">Coordonnées et conditions</div></div>
            <div class="card__body">
                <div class="form-grid">
                    {{ form_row(form.email) }}
                    {{ form_row(form.phone) }}
                    {{ form_row(form.address) }}
                    {{ form_row(form.city) }}
                    {{ form_row(form.country) }}
                    {{ form_row(form.paymentTermsDays) }}
                </div>
                {{ form_row(form.isActive) }}
                {{ form_row(form.notes) }}
            </div>
        </section>

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">Enregistrer les modifications</button>
            <a class="btn btn--ghost" href="{{ path('app_supplier_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
