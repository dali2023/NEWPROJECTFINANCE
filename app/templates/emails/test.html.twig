<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Test de configuration email</title>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f8;padding:24px 12px;">
    <tr>
        <td align="center">
            <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border:1px solid #e4e7ec;border-radius:8px;">
                <tr>
                    <td style="padding:22px 24px;border-bottom:3px solid #0b5c56;">
                        <div style="font-size:16px;font-weight:700;color:#0b5c56;">{{ company.legalName }}</div>
                        <div style="font-size:12px;color:#667085;margin-top:3px;">Test de configuration email</div>
                    </td>
                </tr>
                <tr>
                    <td style="padding:24px;font-size:14px;line-height:1.6;">
                        <p style="margin:0 0 12px;">La configuration SMTP fonctionne : cet email a bien été envoyé.</p>
                        <p style="margin:0 0 6px;"><strong>Serveur :</strong> {{ settings.host }}:{{ settings.port }}</p>
                        <p style="margin:0 0 6px;"><strong>Chiffrement :</strong> {{ settings.encryption.label }}</p>
                        <p style="margin:0;"><strong>Expéditeur :</strong> {{ settings.senderLabel }}</p>
                        <p style="font-size:12px;color:#667085;margin:20px 0 0;">
                            Si vous recevez ce message, les rappels contractuels pourront être envoyés avec ces paramètres.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>