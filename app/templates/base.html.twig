{% set route = app.request.attributes.get('_route') %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Tableau de bord{% endblock %} · {{ app_name }}</title>
    <link rel="stylesheet" href="{{ versioned_asset('assets/app.css') }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%230b5c56'/><text x='16' y='22' font-size='14' font-family='Arial' fill='white' text-anchor='middle'>1</text></svg>">
    <script src="{{ versioned_asset('assets/app.js') }}" defer></script>
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <div class="sidebar__brand">
            <div class="sidebar__logo">ONE</div>
            <div>
                <div class="sidebar__title">Finance &amp;<br>Project Control</div>
                <div class="sidebar__subtitle">ONE ERP SARL</div>
            </div>
        </div>

        <nav class="sidebar__nav" aria-label="Navigation principale">
            <div class="nav-group">
                <div class="nav-group__label">Pilotage</div>
                <a class="nav-link {{ route == 'app_dashboard' ? 'is-active' }}" href="{{ path('app_dashboard') }}">
                    <span class="nav-link__icon">◧</span> Tableau de bord
                </a>
            </div>

            <div class="nav-group">
                <div class="nav-group__label">Projets et tiers</div>
                {% if can('project.view_all') or can('project.view_own') %}
                    <a class="nav-link {{ route starts with 'app_project_' ? 'is-active' }}" href="{{ path('app_project_index') }}">
                        <span class="nav-link__icon">▤</span> Projets
                    </a>
                {% endif %}
                {% if can('client.view') %}
                    <a class="nav-link {{ route starts with 'app_client_' ? 'is-active' }}" href="{{ path('app_client_index') }}">
                        <span class="nav-link__icon">◍</span> Clients
                    </a>
                {% endif %}
                {% if can('supplier.view') %}
                    <a class="nav-link {{ route starts with 'app_supplier_' ? 'is-active' }}" href="{{ path('app_supplier_index') }}">
                        <span class="nav-link__icon">◌</span> Fournisseurs
                    </a>
                {% endif %}
            </div>

            {% if can('contract.view_all') or can('contract.view_own') or can('contract.notify') %}
                <div class="nav-group">
                    <div class="nav-group__label">Contrats et maintenance</div>
                    {% if can('contract.view_all') or can('contract.view_own') %}
                        <a class="nav-link {{ route starts with 'app_contract_' and not (route starts with 'app_contract_calendar_') and not (route starts with 'app_contract_billing_') and not (route starts with 'app_contract_notification_') ? 'is-active' }}" href="{{ path('app_contract_index') }}">
                            <span class="nav-link__icon">▦</span> Registre des contrats
                        </a>
                        <a class="nav-link {{ route starts with 'app_contract_calendar_' ? 'is-active' }}" href="{{ path('app_contract_calendar_index') }}">
                            <span class="nav-link__icon">▥</span> Calendrier
                        </a>
                        <a class="nav-link {{ route starts with 'app_contract_billing_' ? 'is-active' }}" href="{{ path('app_contract_billing_index') }}">
                            <span class="nav-link__icon">▧</span> Facturation à réaliser
                        </a>
                    {% endif %}
                    {% if can('contract.notify') %}
                        <a class="nav-link {{ route starts with 'app_contract_notification_' ? 'is-active' }}" href="{{ path('app_contract_notification_index') }}">
                            <span class="nav-link__icon">◔</span> Alertes contractuelles
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            <div class="nav-group">
                <div class="nav-group__label">Finance</div>
                {% if can('invoice.view') %}
                    <a class="nav-link {{ route starts with 'app_invoice_' ? 'is-active' }}" href="{{ path('app_invoice_index') }}">
                        <span class="nav-link__icon">▤</span> Facturation
                    </a>
                {% endif %}
                {% if can('expense.view') %}
                    <a class="nav-link {{ route starts with 'app_expense_' ? 'is-active' }}" href="{{ path('app_expense_index') }}">
                        <span class="nav-link__icon">▥</span> Charges
                    </a>
                {% endif %}
                {% if can('treasury.view') %}
                    <a class="nav-link {{ route starts with 'app_treasury_' ? 'is-active' }}" href="{{ path('app_treasury_index') }}">
                        <span class="nav-link__icon">◫</span> Trésorerie
                    </a>
                {% endif %}
                {% if can('partner.view') %}
                    <a class="nav-link {{ route starts with 'app_partner_' ? 'is-active' }}" href="{{ path('app_partner_index') }}">
                        <span class="nav-link__icon">◉</span> Associés
                    </a>
                {% endif %}
            </div>

            {% if can('admin.referentials') or can('admin.users') or can('admin.audit') or can('fiscal_year.close') %}
                <div class="nav-group">
                    <div class="nav-group__label">Administration</div>
                    {% if can('admin.referentials') or can('fiscal_year.close') %}
                        <a class="nav-link {{ route starts with 'app_admin_fiscal_year_' ? 'is-active' }}" href="{{ path('app_admin_fiscal_year_index') }}">
                            <span class="nav-link__icon">◫</span> Exercices
                        </a>
                    {% endif %}
                    {% if can('admin.referentials') %}
                        <a class="nav-link {{ route starts with 'app_admin_project_type_' ? 'is-active' }}" href="{{ path('app_admin_project_type_index') }}">
                            <span class="nav-link__icon">◈</span> Types de projet
                        </a>
                    {% endif %}
                    {% if can('admin.users') %}
                        <a class="nav-link {{ route starts with 'app_admin_user_' ? 'is-active' }}" href="{{ path('app_admin_user_index') }}">
                            <span class="nav-link__icon">◉</span> Utilisateurs
                        </a>
                        <a class="nav-link {{ route starts with 'app_admin_role_' ? 'is-active' }}" href="{{ path('app_admin_role_index') }}">
                            <span class="nav-link__icon">◎</span> Rôles et permissions
                        </a>
                    {% endif %}
                    {% if can('admin.audit') %}
                        <a class="nav-link {{ route starts with 'app_admin_audit_' ? 'is-active' }}" href="{{ path('app_admin_audit_index') }}">
                            <span class="nav-link__icon">≡</span> Journal d’audit
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </nav>

        <div class="sidebar__footer">
            Version 1.0 · {{ app_currency }} · {{ app_locale|upper }}
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="breadcrumb">{% block breadcrumb %}{% endblock %}</div>
            {% if app.user %}
                <div class="topbar__user">
                    <div class="avatar">{{ app.user.fullName|slice(0, 2)|upper }}</div>
                    <div class="user-meta">
                        <div>{{ app.user.fullName }}</div>
                        <div class="user-meta__role">
                            {% for role in app.user.assignedRoles %}{{ role.label }}{% if not loop.last %} · {% endif %}{% endfor %}
                        </div>
                    </div>
                    <button type="button" class="btn btn--print btn--sm" data-print>
                        <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 8V3h10v5"/>
                            <path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/>
                            <rect x="7" y="14" width="10" height="7" rx="1"/>
                        </svg>
                        Imprimer
                    </button>
                    <a class="btn btn--ghost btn--sm" href="{{ path('app_logout') }}">Déconnexion</a>
                </div>
            {% endif %}
        </header>

        <main class="content">
            <div class="print-only print-head">
                <div class="print-head__brand">ONE ERP · Finance &amp; Project Control</div>
                <div class="print-head__meta">{{ 'now'|date('d/m/Y H:i') }}</div>
            </div>
            {% include 'partials/_flash.html.twig' %}
            {% block body %}{% endblock %}
        </main>
    </div>
</div>
</body>
</html>
