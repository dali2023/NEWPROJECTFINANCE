{% extends 'base.html.twig' %}

{% block title %}Modifier {{ contract.reference }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_contract_index') }}">Contrats</a> / <a href="{{ path('app_contract_show', {id: contract.idString}) }}">{{ contract.reference }}</a> / Modifier{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Modifier {{ contract.reference }}</h1>
            <div class="page-head__subtitle">{{ contract.title }}</div>
        </div>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {% include 'contract/_form.html.twig' %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">Enregistrer</button>
            <a class="btn btn--ghost" href="{{ path('app_contract_show', {id: contract.idString}) }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
