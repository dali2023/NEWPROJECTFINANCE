{% extends 'base.html.twig' %}

{% block title %}Nouveau contrat{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_contract_index') }}">Contrats</a> / Nouveau{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Nouveau contrat</h1>
            <div class="page-head__subtitle">
                Référence réservée : <span class="mono">{{ form.vars.data.reference }}</span>
            </div>
        </div>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {% include 'contract/_form.html.twig' %}
        <div class="form-actions">
            <button class="btn btn--primary" type="submit">Créer le contrat</button>
            <a class="btn btn--ghost" href="{{ path('app_contract_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
