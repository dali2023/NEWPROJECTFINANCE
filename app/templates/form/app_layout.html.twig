{% use 'form_div_layout.html.twig' %}

{# Ligne de formulaire standard : libellé, champ, aide, erreurs. #}
{% block form_row %}
    {% set is_checkbox = 'checkbox' in form.vars.block_prefixes %}
    {% set is_expanded = form.vars.expanded is defined and form.vars.expanded %}
    <div class="field{{ errors|length ? ' field--error' }}{{ is_checkbox or is_expanded ? ' field--checkbox' }}">
        {{ form_label(form) }}
        {% if is_expanded %}
            <div class="choice-list">{{ form_widget(form) }}</div>
        {% else %}
            {{ form_widget(form) }}
        {% endif %}
        {{ form_help(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="field field--checkbox{{ errors|length ? ' field--error' }}">
        <label>
            {{ form_widget(form) }}
            <span>{{ form.vars.label|trans({}, 'messages') }}</span>
        </label>
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_help %}
    {% if help is not empty %}
        <div class="help">{{ help }}</div>
    {% endif %}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="form-errors">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block choice_widget_expanded %}
    {% for child in form %}
        <div>
            {{ form_widget(child) }}
        </div>
    {% endfor %}
{% endblock %}

{% block checkbox_widget %}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %}>
{% endblock %}
