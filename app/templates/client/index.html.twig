{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block breadcrumb %}Tiers / Clients{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Clients</h1>
            <div class="page-head__subtitle">{{ result.total }} fiche{{ result.total > 1 ? 's' : '' }} client</div>
        </div>
        <div class="page-head__actions">
            {% if can('client.manage') %}
                <a class="btn btn--primary" href="{{ path('app_client_new') }}">Nouveau client</a>
            {% endif %}
        </div>
    </div>

    <section class="card">
        <form method="get" action="{{ path('app_client_index') }}" class="toolbar">
            <div class="field">
                <label for="q">Recherche</label>
                <input type="text" id="q" name="q" value="{{ term }}" placeholder="Nom ou code">
            </div>
            <div class="field">
                <label for="type">Type</label>
                <select id="type" name="type" data-auto-submit>
                    <option value="">Tous les types</option>
                    {% for client_type in client_types %}
                        <option value="{{ client_type.value }}" {{ type and type.value == client_type.value ? 'selected' }}>{{ client_type.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="field field--checkbox" style="min-width:auto;">
                <label><input type="checkbox" name="actifs" value="1" {{ active_only ? 'checked' }}> Actifs seulement</label>
            </div>
            <button class="btn" type="submit">Filtrer</button>
            {% if term or type or active_only %}
                <a class="btn btn--ghost" href="{{ path('app_client_index') }}">Réinitialiser</a>
            {% endif %}
        </form>

        {% if result.items is empty %}
            <div class="empty">
                Aucun client trouvé.
                {% if can('client.manage') %}
                    <br><a href="{{ path('app_client_new') }}">Créer un client</a>
                {% endif %}
            </div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                    <tr>
                        <th>Code</th>
                        <th>Raison sociale</th>
                        <th>Type</th>
                        <th>Contact</th>
                        <th class="num">Délai</th>
                        <th>Statut</th>
                        <th class="actions"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for client in result.items %}
                        <tr>
                            <td><span class="mono">{{ client.code }}</span></td>
                            <td>
                                <a href="{{ path('app_client_show', {id: client.idString}) }}">{{ client.name }}</a>
                                {% if client.taxIdentifier %}<div class="cell-sub">{{ client.taxIdentifier }}</div>{% endif %}
                            </td>
                            <td><span class="badge {{ client.clientType.badgeClass }}">{{ client.clientType.label }}</span></td>
                            <td>
                                {% if client.contactName %}{{ client.contactName }}{% endif %}
                                {% if client.email %}<div class="cell-sub">{{ client.email }}</div>{% endif %}
                            </td>
                            <td class="num">{{ client.paymentTermsDays }} j</td>
                            <td>
                                {% if client.isActive %}
                                    <span class="badge badge--success">Actif</span>
                                {% else %}
                                    <span class="badge badge--muted">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="actions">
                                {% if can('client.manage') %}
                                    <a class="btn btn--ghost btn--sm" href="{{ path('app_client_edit', {id: client.idString}) }}">Modifier</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include 'partials/_pagination.html.twig' %}
        {% endif %}
    </section>
{% endblock %}
