{% extends 'base.html.twig' %}

{% block title %}Nouveau projet{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_project_index') }}">Projets</a> / Nouveau{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Nouveau projet</h1>
            <div class="page-head__subtitle">
                La référence <span class="mono">{{ form.vars.data.code }}</span> a été réservée automatiquement.
            </div>
        </div>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        {% include 'project/_form.html.twig' %}

        <div class="form-actions">
            <button class="btn btn--primary" type="submit">Créer le projet</button>
            <a class="btn btn--ghost" href="{{ path('app_project_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
