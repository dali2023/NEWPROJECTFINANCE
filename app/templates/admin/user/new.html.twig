{% extends 'base.html.twig' %}

{% block title %}Nouvel utilisateur{% endblock %}
{% block breadcrumb %}<a href="{{ path('app_admin_user_index') }}">Utilisateurs</a> / Nouveau{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Nouvel utilisateur</h1>
            <div class="page-head__subtitle">Le mot de passe doit contenir au moins 8 caractères.</div>
        </div>
    </div>

    <section class="card" style="max-width:760px;">
        <div class="card__body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                <div class="form-grid">
                    {{ form_row(form.fullName) }}
                    {{ form_row(form.username) }}
                    {{ form_row(form.email) }}
                </div>
                {{ form_row(form.assignedRoles) }}
                {{ form_row(form.isActive) }}
                <div class="form-grid">
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                </div>

                <div class="form-actions">
                    <button class="btn btn--primary" type="submit">Créer le compte</button>
                    <a class="btn btn--ghost" href="{{ path('app_admin_user_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
