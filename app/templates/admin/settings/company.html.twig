{% extends 'base.html.twig' %}

{% block title %}Paramètres société{% endblock %}
{% block breadcrumb %}Administration / Paramètres société{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Paramètres société</h1>
            <div class="page-head__subtitle">
                Identité, coordonnées et logo utilisés dans l’application, les impressions et les emails.
            </div>
        </div>
        <div class="page-head__actions">
            <a class="btn btn--print" href="{{ path('app_admin_settings_mail') }}">
                <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 6h16v12H4z"/>
                    <path d="m4 7 8 6 8-6"/>
                </svg>
                Paramètres email
            </a>
        </div>
    </div>

    <section class="card">
        <div class="card__body">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                <div class="grid grid--sidebar">
                    <div>
                        <fieldset>
                            <legend>Identité de la société</legend>
                            <div class="grid grid--2">
                                {{ form_row(form.legalName) }}
                                {{ form_row(form.tradeName) }}
                                {{ form_row(form.taxId) }}
                                {{ form_row(form.website) }}
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>Coordonnées</legend>
                            <div class="grid grid--2">
                                {{ form_row(form.email) }}
                                {{ form_row(form.phone) }}
                                {{ form_row(form.phoneSecondary) }}
                            </div>
                            {{ form_row(form.address) }}
                            <div class="grid grid--2">
                                {{ form_row(form.postalCode) }}
                                {{ form_row(form.city) }}
                                {{ form_row(form.country) }}
                            </div>
                        </fieldset>
                    </div>

                    <aside>
                        <div class="settings-logo">
                            <div class="section-title">Logo</div>
                            {% if company.hasLogo %}
                                <img class="settings-logo__image"
                                     src="{{ path('app_company_logo') }}?v={{ company.updatedAt ? company.updatedAt|date('U') : '1' }}"
                                     alt="Logo {{ company.displayName }}">
                                <div class="settings-logo__meta">
                                    {{ company.logoOriginalName ?: 'Logo enregistré' }}
                                </div>
                            {% else %}
                                <div class="settings-logo__placeholder">{{ company.initials }}</div>
                                <div class="settings-logo__meta muted">Aucun logo : les initiales sont utilisées.</div>
                            {% endif %}
                            {{ form_row(form.logo) }}
                            {% if company.hasLogo %}
                                {{ form_row(form.removeLogo) }}
                            {% endif %}
                        </div>
                    </aside>
                </div>

                <div class="form-actions">
                    <button class="btn btn--primary" type="submit">Enregistrer</button>
                    <a class="btn btn--ghost" href="{{ path('app_dashboard') }}">Annuler</a>
                </div>
                {{ form_widget(form._token) }}
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </section>
{% endblock %}